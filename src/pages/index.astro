---
import Layout from '../layouts/Layout.astro';
import PdfEditor from '../components/PdfEditor.jsx';
---

<Layout title="Free Online PDF Editor & Form Filler | Secure, No Uploads">
	<main class="min-h-screen bg-stone-50 flex flex-col items-center selection:bg-red-200 selection:text-red-900">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": "EditPDF",
					"url": "https://editpdf.github.io/",
					"description": "Edit PDF files securely in your browser. A minimal, powerful, and private PDF editor with no uploads required.",
					"applicationCategory": "UtilitiesApplication",
					"operatingSystem": "Any",
					"offers": {
						"@type": "Offer",
						"price": "0"
					}
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": "Is my data secure?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Absolutely. EditPDF processes everything entirely within your own web browser. Your PDF files are never uploaded to any cloud server, ensuring 100% privacy and security."
							}
						},
						{
							"@type": "Question",
							"name": "Can I add my own signature?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "Yes, you can draw your signature, type it out using various fonts, or upload an image of your signature. Once added, you can resize and drag it anywhere on the document."
							}
						},
						{
							"@type": "Question",
							"name": "Do I need to create an account?",
							"acceptedAnswer": {
								"@type": "Answer",
								"text": "No, EditPDF is a free, instant tool. There are no accounts, no subscriptions, and no hidden fees required to edit your documents."
							}
						}
					]
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{
							"@type": "ListItem",
							"position": 1,
							"name": "Home",
							"item": "https://editpdf.github.io/"
						},
						{
							"@type": "ListItem",
							"position": 2,
							"name": "PDF Editor"
						}
					]
				}
			]
		})} />

		{/* Header */}
		<header class="w-full bg-white border-b border-stone-200/60 sticky top-0 z-40 backdrop-blur-md">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
				<div class="flex items-center gap-2">
					<div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white font-bold text-lg">
						P
					</div>
					<span class="font-bold text-xl tracking-tight text-stone-900">EditPDF</span>
				</div>
				<nav class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-600">
					<a href="#faq" class="hover:text-red-600 transition-colors">FAQ</a>
				</nav>
			</div>
		</header>

		{/* Header Area & H1 */}
		<div class="w-full max-w-7xl mx-auto pt-10 px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
			<div class="max-w-3xl">
				<h1 class="text-3xl font-bold tracking-tight text-stone-900">Free Secure PDF Editor - Fill Forms & Sign Instantly</h1>
				<p class="text-stone-500 mt-3 text-sm">Edit PDF files without uploading to any server. Everything happens locally in your browser.</p>
			</div>
		</div>

		{/* Editor Area */}
		<div id="editor" class="w-full max-w-7xl mx-auto min-h-[calc(100vh-12rem)] flex-grow flex flex-col p-4 sm:p-6 lg:p-8">
			<PdfEditor client:only="react" />
		</div>
		
		{/* How it Works Section */}
		<section class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-stone-200">
			<h2 class="text-2xl font-bold text-stone-900 mb-6 text-center tracking-tight">How our Secure PDF Editor Works</h2>
			<div class="bg-white border border-stone-200 p-8 text-stone-600 leading-relaxed text-sm shadow-sm space-y-4">
				<p>Looking to edit PDF forms easily without compromising your privacy? Our free online PDF editor lets you add text, draw your signature, and fill out documents instantly.</p>
				<p>Most online PDF tools force you to upload your sensitive files (like bank statements or contracts) to their remote servers. We take a different approach. Because everything runs locally right inside your web browser using modern web technologies, it is the most secure PDF form filler available - absolutely <strong>no server uploads required.</strong></p>
			</div>
		</section>

		{/* FAQ Section */}
		<section id="faq" class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<h2 class="text-2xl font-bold text-stone-900 mb-8 text-center tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-6">
				<div class="bg-white border border-stone-200 p-6">
					<h3 class="text-lg font-semibold text-stone-900 mb-2">Is my data secure?</h3>
					<p class="text-stone-600 leading-relaxed text-sm">Absolutely. EditPDF processes everything entirely within your own web browser. Your PDF files are never uploaded to any cloud server, ensuring 100% privacy and security.</p>
				</div>
				<div class="bg-white border border-stone-200 p-6">
					<h3 class="text-lg font-semibold text-stone-900 mb-2">Can I add my own signature?</h3>
					<p class="text-stone-600 leading-relaxed text-sm">Yes, you can draw your signature, type it out using various fonts, or upload an image of your signature. Once added, you can resize and drag it anywhere on the document.</p>
				</div>
				<div class="bg-white border border-stone-200 p-6">
					<h3 class="text-lg font-semibold text-stone-900 mb-2">Do I need to create an account?</h3>
					<p class="text-stone-600 leading-relaxed text-sm">No, EditPDF is a free, instant tool. There are no accounts, no subscriptions, and no hidden fees required to edit your documents.</p>
				</div>
			</div>
		</section>

		{/* Footer */}
		<footer class="w-full py-6 text-center text-sm text-stone-500 bg-stone-50 border-t border-stone-200/60 mt-auto">
			<p>&copy; {new Date().getFullYear()} EditPDF. All processing happens locally in your browser.</p>
		</footer>
	</main>
</Layout>

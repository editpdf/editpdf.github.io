---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PdfEditor from '../../components/PdfEditor.jsx';
import { languages, defaultLang, ui, type Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
	return (Object.keys(languages) as Locale[])
		.filter((l) => l !== defaultLang)
		.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const dict = ui[lang];
---

<Layout title={t('seo.title')} description={t('seo.description')} lang={lang}>
	<main class="min-h-screen bg-stone-50 dark:bg-slate-950 flex flex-col items-center selection:bg-red-200 selection:text-red-900 dark:selection:bg-red-900 dark:selection:text-red-100 transition-colors duration-200">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebApplication",
					"name": t('brand.name'),
					"url": `https://editpdf.github.io/${lang}/`,
					"description": t('seo.description'),
					"applicationCategory": "UtilitiesApplication",
					"operatingSystem": "Any",
					"offers": {
						"@type": "Offer",
						"price": "0"
					}
				},
				{
					"@type": "FAQPage",
					"mainEntity": [
						{
							"@type": "Question",
							"name": t('faq.q1'),
							"acceptedAnswer": {
								"@type": "Answer",
								"text": t('faq.a1')
							}
						},
						{
							"@type": "Question",
							"name": t('faq.q2'),
							"acceptedAnswer": {
								"@type": "Answer",
								"text": t('faq.a2')
							}
						},
						{
							"@type": "Question",
							"name": t('faq.q3'),
							"acceptedAnswer": {
								"@type": "Answer",
								"text": t('faq.a3')
							}
						}
					]
				},
				{
					"@type": "BreadcrumbList",
					"itemListElement": [
						{
							"@type": "ListItem",
							"position": 1,
							"name": "Home",
							"item": "https://editpdf.github.io/"
						},
						{
							"@type": "ListItem",
							"position": 2,
							"name": t('brand.name')
						}
					]
				}
			]
		})} />

		{/* Navigation Header */}
		<Header currentLang={lang} />

		{/* Header Area & H1 */}
		<div class="w-full max-w-7xl mx-auto pt-10 px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
			<div class="max-w-3xl">
				<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 dark:text-white">
					{t('hero.h1')}
				</h1>
				<p class="text-stone-500 dark:text-stone-400 mt-3 text-sm sm:text-base">
					{t('hero.subtitle')}
				</p>
			</div>
		</div>

		{/* Editor Area */}
		<div id="editor" class="w-full max-w-7xl mx-auto min-h-[calc(100vh-12rem)] flex-grow flex flex-col p-4 sm:p-6 lg:p-8">
			<PdfEditor client:only="react" dict={dict} />
		</div>
		
		{/* How it Works Section */}
		<section class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-stone-200 dark:border-slate-800">
			<h2 class="text-2xl font-bold text-stone-900 dark:text-white mb-6 text-center tracking-tight">
				{t('how.title')}
			</h2>
			<div class="bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 p-8 text-stone-600 dark:text-stone-300 leading-relaxed text-sm shadow-sm rounded-xl space-y-4 transition-colors">
				<p>{t('how.p1')}</p>
				<p>{t('how.p2')}</p>
			</div>
		</section>

		{/* FAQ Section */}
		<section id="faq" class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-stone-200 dark:border-slate-800">
			<h2 class="text-2xl font-bold text-stone-900 dark:text-white mb-8 text-center tracking-tight">
				{t('faq.title')}
			</h2>
			<div class="space-y-6">
				<div class="bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 p-6 rounded-xl transition-colors shadow-sm">
					<h3 class="text-lg font-semibold text-stone-900 dark:text-white mb-2">
						{t('faq.q1')}
					</h3>
					<p class="text-stone-600 dark:text-stone-300 leading-relaxed text-sm">
						{t('faq.a1')}
					</p>
				</div>
				<div class="bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 p-6 rounded-xl transition-colors shadow-sm">
					<h3 class="text-lg font-semibold text-stone-900 dark:text-white mb-2">
						{t('faq.q2')}
					</h3>
					<p class="text-stone-600 dark:text-stone-300 leading-relaxed text-sm">
						{t('faq.a2')}
					</p>
				</div>
				<div class="bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 p-6 rounded-xl transition-colors shadow-sm">
					<h3 class="text-lg font-semibold text-stone-900 dark:text-white mb-2">
						{t('faq.q3')}
					</h3>
					<p class="text-stone-600 dark:text-stone-300 leading-relaxed text-sm">
						{t('faq.a3')}
					</p>
				</div>
			</div>
		</section>

		{/* Footer */}
		<footer class="w-full py-6 text-center text-sm text-stone-500 dark:text-stone-400 bg-stone-50 dark:bg-slate-950 border-t border-stone-200/60 dark:border-slate-800 mt-auto transition-colors">
			<p>&copy; {new Date().getFullYear()} {t('brand.name')}. {t('footer.text')}</p>
		</footer>
	</main>
</Layout>

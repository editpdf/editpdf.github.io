---
import '../styles/global.css';
import { defaultLang, languages, type Locale } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	lang?: Locale;
}

const currentLang: Locale = Astro.props.lang || getLangFromUrl(Astro.url);
const title = Astro.props.title || 'Free Online PDF Editor & Form Filler | Secure, No Uploads';
const description = Astro.props.description || 'Edit PDF files, fill forms, and add signatures instantly in your browser. 100% free and secure - your files are never uploaded to any server.';

const siteBase = 'https://editpdf.github.io';
const translatePath = useTranslatedPath(currentLang);
const canonicalUrl = new URL(translatePath(''), siteBase).href;

// 7 bidirectional hreflang links (en, es, pt, de, fr, ja + x-default)
const hreflangLinks = [
	...Object.keys(languages).map((loc) => ({
		hreflang: loc,
		href: loc === defaultLang ? `${siteBase}/` : `${siteBase}/${loc}/`,
	})),
	{
		hreflang: 'x-default',
		href: `${siteBase}/`,
	},
];
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="index, follow" />
		<meta name="google-site-verification" content="VcuzgKAUM7X1Jrj8eB91qjYDEOPZ-v0OZdluF9pyL-4" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />

		{/* 7 Bidirectional hreflang tags */}
		{hreflangLinks.map((item) => (
			<link rel="alternate" hreflang={item.hreflang} href={item.href} />
		))}

		{/* Anti-FOUC Synchronous Theme Initialization Script */}
		<script is:inline>
			(function () {
				try {
					const storedTheme = localStorage.getItem('theme');
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				} catch (_) {}
			})();
		</script>

		{/* Open Graph / Facebook */}
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png" />

		{/* Twitter */}
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png" />

		{/* Google tag (gtag.js) */}
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4N8MGZF1YQ"></script>
		<script>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-4N8MGZF1YQ');
		</script>
	</head>
	<body class="bg-white text-stone-900 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased selection:bg-red-200 selection:text-red-900 dark:selection:bg-red-900 dark:selection:text-red-100 transition-colors duration-200">
		<slot />
	</body>
</html>
